# ══════════════════════════════════════════════════════════════
# LingoBridge Client — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in values.
# NEVER put secret keys here — this file is bundled into the browser.
# Vite only exposes variables prefixed with VITE_
# ══════════════════════════════════════════════════════════════

# ── Backend API ───────────────────────────────────────────────
# URL of the running server (no trailing slash)
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# ── Supabase (PUBLIC keys only — safe to expose) ──────────────
# Found at: Supabase Dashboard → Project Settings → API
# Use the "anon" public key here, NOT the service role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_THIS

# ── Agora ─────────────────────────────────────────────────────
# Only the App ID goes here (not the certificate — that stays on the server).
# The frontend uses this ID + a server-generated token to join channels.
VITE_AGORA_APP_ID=your_agora_app_id_here
