# ══════════════════════════════════════════════════════════════
# LingoBridge Server — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in ALL values before starting.
# NEVER commit .env to git. Only commit this .env.example file.
# ══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slash)
# Development: http://localhost:5174
# Production:  https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5174

FRONTEND_URL=http://localhost:5174

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Supabase ──────────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API
#
# IMPORTANT: The SERVICE_ROLE_KEY has admin-level database access
# and bypasses Row Level Security. NEVER expose it in client code.
# If this key was ever committed to git, rotate it immediately at:
# Supabase Dashboard → Settings → API → Rotate service role secret
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_THIS

# ── Agora ─────────────────────────────────────────────────────
# Found at: console.agora.io → Your project → App ID + Certificate
# The APP_CERTIFICATE is used to sign RTC tokens server-side.
# The frontend only receives short-lived tokens, never the certificate.
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# ── LemonSqueezy (payments) ───────────────────────────────────
# Found at: app.lemonsqueezy.com → Settings → API
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret

# Variant IDs for top-up amounts (from your LemonSqueezy products)
LS_VARIANT_USD_10=your_variant_id
LS_VARIANT_USD_25=your_variant_id
LS_VARIANT_USD_50=your_variant_id
LS_VARIANT_USD_100=your_variant_id

# ── Redis (optional) ──────────────────────────────────────────
# If set, Socket.IO will use Redis adapter for multi-instance scaling.
# If not set, falls back to in-memory (fine for single-instance).
# Format: redis://[:password@]host[:port][/db]
REDIS_URL=redis://localhost:6379
